# 서명 열쇠 · release signing — COPY THIS FILE, DO NOT EDIT IT IN PLACE
#
#   cp android/keystore.properties.example android/keystore.properties
#
# keystore.properties is in .gitignore and must stay there. The .jks file must
# never be committed either.
#
# ── Make the upload key once ──────────────────────────────────────────────
#   keytool -genkeypair -v \
#     -keystore ~/worklog-upload.jks \
#     -alias worklog -keyalg RSA -keysize 4096 -validity 10000
#
# ── Then back it up, in two places that are not this laptop ───────────────
# Google Play signs releases with a key it holds, but every update you upload
# must be signed with THIS key. If you lose it you cannot update the app the
# workers already have — they would have to uninstall (which destroys their
# records) and install a new listing. There is no recovery and no appeal.
# Back up the .jks file and both passwords before you ship anything.
#
# Paths may be absolute, or relative to the android/ folder. Keep the keystore
# OUTSIDE this repository.

storeFile=/Users/you/worklog-upload.jks
storePassword=CHANGE_ME
keyAlias=worklog
keyPassword=CHANGE_ME
